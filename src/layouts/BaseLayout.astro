---
import Footer from "../components/layout/Footer.astro";
import PageHeader from "../components/layout/PageHeader.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import { THEME, UI_TEXT } from "../constants/ui";
import { site } from "../data/site";
import "../styles/global.css";

interface Props {
	title: string;
	heading: string;
	description?: string;
	noindex?: boolean;
}

const {
	title,
	heading,
	description = site.description,
	noindex = false,
} = Astro.props;
const documentTitle = title === "Home" ? site.name : `${title} | ${site.name}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? site.url);
const themeStorageKey = THEME.storageKey;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}

		<script is:inline define:vars={{ themeStorageKey }}>
			(() => {
				const root = document.documentElement;
				const prefersDark = window.matchMedia(
					"(prefers-color-scheme: dark)",
				).matches;
				let savedTheme = null;

				try {
					savedTheme = localStorage.getItem(themeStorageKey);
				} catch {
					// Fall back to the operating-system preference.
				}

				root.dataset.theme =
					savedTheme === "light" || savedTheme === "dark"
						? savedTheme
						: prefersDark
							? "dark"
							: "light";
			})();
		</script>

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={documentTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={site.name} />

		<title>{documentTitle}</title>
	</head>

	<body class="flex min-h-screen flex-col">
		<a
			href="#main-content"
			class="bg-highlight text-deep fixed top-3 left-3 z-[100] -translate-y-20 rounded-md px-4 py-2 font-bold transition-transform focus:translate-y-0"
		>
			{UI_TEXT.accessibility.skipToContent}
		</a>

		<SiteHeader />

		<main id="main-content" class="flex-1">
			<PageHeader heading={heading} description={description} />
			<slot />
		</main>

		<Footer />
	</body>
</html>
