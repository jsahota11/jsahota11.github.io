---
import UpdateCard from "../components/cards/UpdateCard.astro";
import PageContainer from "../components/layout/PageContainer.astro";
import { updates } from "../data/updates";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Updates"
    heading="Recent updates"
    description="A little record of additions and changes to the site."
>
    <PageContainer>
        <div>
            {updates.map((update) => <UpdateCard update={update} />)}
        </div>
    </PageContainer>
</BaseLayout>
