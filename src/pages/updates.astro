---
import UpdateCard from "../components/cards/UpdateCard.astro";
import PageContainer from "../components/layout/PageContainer.astro";
import { updates } from "../data/updates";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Updates"
  heading="Recent updates"
  description="A short record of meaningful additions and changes to this site (soon Ill also add a space for personal updates)."
>
  <PageContainer>
    <div class="space-y-6">
      {updates.map((update) => <UpdateCard update={update} />)}
    </div>
  </PageContainer>
</BaseLayout>
