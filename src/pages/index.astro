---
import PageContainer from "../components/layout/PageContainer.astro";
import ProfileIntro from "../components/sections/ProfileIntro.astro";
import ContentSection from "../components/ui/ContentSection.astro";
import LinkGrid from "../components/ui/LinkGrid.astro";
import { documentLinks } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import DocumentPreview from "../components/ui/DocumentPreview.astro";
---

<BaseLayout
  title="Home"
  heading="Jatinder Sahota"
  description="Computer Science, mathematics, research, and systems programming."
>
  <PageContainer>
    <ProfileIntro />

    <ContentSection id="documents" title="Documents" class="mt-12">
      <p>
        Resume, academic record, and the results of my Summer 2025 research
        project.
      </p>
      <LinkGrid items={documentLinks} />
      <DocumentPreview />
    </ContentSection>
  </PageContainer>
</BaseLayout>
