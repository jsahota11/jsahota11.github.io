---
import PageContainer from "../components/layout/PageContainer.astro";
import LinkGrid from "../components/ui/LinkGrid.astro";
import { contactLinks, site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Contact"
    heading="Get in touch"
    description="The best ways to reach me or follow what I am building."
>
    <PageContainer>
        <p>
            I’m based in {site.location}. Email is the most direct way to reach
            me; GitHub and LinkedIn are useful for seeing more of my work.
        </p>
        <LinkGrid items={contactLinks} />
    </PageContainer>
</BaseLayout>
