---
import ProjectCard from "../components/cards/ProjectCard.astro";
import PageContainer from "../components/layout/PageContainer.astro";
import { projects } from "../data/projects";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Projects"
  heading="Projects"
  description="Selected software projects spanning graph visualization, file systems, and object-oriented design. If you're curious about this website specifically, its build with Astro!"
>
  <PageContainer>
    <div class="grid gap-6 md:grid-cols-2">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </PageContainer>
</BaseLayout>
