---
import ExperienceCard from "../components/cards/ExperienceCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageContainer from "../components/layout/PageContainer.astro";
import { experiences } from "../data/experience";
---

<BaseLayout
    title="Experience"
    heading="Experience"
    description="Work, undergraduate research, tutoring/teaching experience, and education."
>
    <PageContainer>
        {
            experiences.map((experience) => (
                <ExperienceCard experience={experience} />
            ))
        }
    </PageContainer>
</BaseLayout>
