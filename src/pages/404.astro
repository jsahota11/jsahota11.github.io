---
import PageContainer from "../components/layout/PageContainer.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import ContentSection from "../components/ui/ContentSection.astro";
import { UI_TEXT } from "../constants/ui";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  heading="Page not found"
  description="The page you were looking for does not exist or may have moved."
  noindex
>
  <PageContainer>
    <ContentSection>
      <p>
        That link did not lead anywhere, but the rest of the site is still close
        by.
      </p>
      <ButtonLink href="/">
        {UI_TEXT.actions.returnHome}
      </ButtonLink>
    </ContentSection>
  </PageContainer>
</BaseLayout>
