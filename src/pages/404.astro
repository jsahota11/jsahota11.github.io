---
import PageContainer from "../components/layout/PageContainer.astro";
import ContentSection from "../components/ui/ContentSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found"
  heading="Page not found"
  description="The page you were looking for does not exist or may have moved."
  noindex
>
  <PageContainer>
    <ContentSection>
      <p>
        That link did not lead anywhere, but the rest of the site is still close
        by!
      </p>
      <a
        href="/"
      >
        Return home
      </a>
    </ContentSection>
  </PageContainer>
</BaseLayout>
