---
import logo from "../../assets/images/brand/logo.svg";
import { site } from "../../data/site";

interface Props {
  size?: number;
}

const { size = 64 } = Astro.props;
const height = Math.round((size * logo.height) / logo.width);
---

<a
  href="/"
  class="flex origin-top-left items-center space-x-2 transition-transform duration-300 ease-out hover:scale-125"
>
  <img src={logo.src} alt="" width={size} height={height} />
</a>
