---
import logo from "../../assets/images/brand/logo.svg";
import { UI_TEXT } from "../../constants/ui";
import { site } from "../../data/site";

interface Props {
  size?: number;
}

const { size = 64 } = Astro.props;
const height = Math.round((size * logo.height) / logo.width);
---

<a
  href="/"
  aria-label={UI_TEXT.navigation.homeLabel(site.name)}
  class="site-logo inline-flex shrink-0 items-center"
>
  <img src={logo.src} alt="" width={size} height={height} class="h-auto" />
</a>
