---
const { size = 32 } = Astro.props;
const hoverScale = (size + 20) / size; // since tailwind cant do dynamic
---

<a
  href="/"
  class="flex items-center space-x-2 transition-transform duration-300 ease-out origin-top-left hover:scale-125"
>
  <img src="/logo.svg" alt="Logo" width={size} height={size} />
</a>
