---
interface Props {
  heading: string;
  description?: string;
}

const { heading, description } = Astro.props;
---

<header class="border-ink/10 bg-canvas-soft border-b">
  <div
    class="max-w-site mx-auto w-full px-4 py-8 sm:px-6 sm:py-12 lg:px-8 lg:py-14"
  >
    <h1
      class="text-ink-muted text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl"
    >
      {heading}
    </h1>
    {
      description && (
        <p class="text-ink/75 mt-4 max-w-3xl text-base leading-7 text-pretty sm:text-lg">
          {description}
        </p>
      )
    }
  </div>
</header>
