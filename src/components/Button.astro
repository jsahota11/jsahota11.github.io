---
const { label, link } = Astro.props;

// see if current URL matches button
const isActive = Astro.url.pathname === link;
---

<div class="border-solid rounded-md border-2 border-[#a2c7fe] m-1">
    <a href={link} class="nav-link">
        <!-- hovering and clicking will change the state of the button -->
        <button
            class="p-1 w-32 h-10 hover:bg-[#a2c7fe] hover:text-white active:bg-[#82b4ff] active:text-white
            transition-colors duration-200"
        >
            {label}
        </button>
    </a>
</div>
