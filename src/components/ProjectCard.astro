---
const { title, images, description, github } = Astro.props;
---

<div
    class="relative group w-80 h-60 flex-shrink-0 rounded-xl overflow-hidden shadow-lg"
>
    <!-- Slideshow -->
    <div class="relative w-full h-full overflow-hidden">
        <!-- Replace with carousel component -->
        <img src={images[0]} alt={title} class="w-full h-full object-cover" />
    </div>

    <!-- Hover Blurb -->
    <div
        class="absolute bottom-0 left-0 right-0 bg-black/70 text-white text-sm p-3 transform translate-y-full group-hover:translate-y-0 transition-transform duration-300"
    >
        <h3 class="font-bold text-lg">{title}</h3>
        <p class="mt-1">{description}</p>
        {
            github && (
                <a
                    href={github}
                    target="_blank"
                    class="inline-block mt-2 text-blue-300 underline"
                >
                    View on GitHub
                </a>
            )
        }
    </div>
</div>
