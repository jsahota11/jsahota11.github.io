---
import { UI_TEXT } from "../../constants/ui";
import type { LinkItem } from "../../types/content";

interface Props {
  items: LinkItem[];
}

const { items } = Astro.props;
---

<ul class="grid gap-4 sm:grid-cols-2">
  {
    items.map((item) => (
      <li>
        <a
          href={item.href}
          target={item.newTab ? "_blank" : undefined}
          rel={item.newTab ? "noopener noreferrer" : undefined}
          data-document-preview={item.preview === "pdf" ? "" : undefined}
          data-document-title={item.preview === "pdf" ? item.label : undefined}
          aria-haspopup={item.preview === "pdf" ? "dialog" : undefined}
          class="surface-card surface-card-interactive pressable group border-ink/15 hover:border-accent flex h-full min-w-0 items-start justify-between gap-4 p-5"
        >
          <span class="min-w-0">
            <span class="text-ink-muted group-hover:text-accent block font-bold">
              {item.label}
            </span>
            <span class="text-ink/70 mt-1 block text-sm leading-6 break-words">
              {item.description}
            </span>
          </span>
          <span aria-hidden="true" class="text-accent mt-0.5 text-xl">
            {item.preview === "pdf"
              ? UI_TEXT.symbols.preview
              : item.newTab
                ? UI_TEXT.symbols.externalLink
                : UI_TEXT.symbols.internalLink}
          </span>
        </a>
      </li>
    ))
  }
</ul>
