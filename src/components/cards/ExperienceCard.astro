---
import { Image } from "astro:assets";
import Card from "../ui/Card.astro";
import type { Experience } from "../../types/content";

interface Props {
  experience: Experience;
}

const { experience } = Astro.props;
const dateFormat = new Intl.DateTimeFormat("en-CA", {
  year: "numeric",
  month: "long",
  timeZone: "UTC",
});

const formattedStartDate = dateFormat.format(
  new Date(`${experience.startDate}T00:00:00Z`),
);
const formattedEndDate = dateFormat.format(
  new Date(`${experience.endDate}T00:00:00Z`),
);
---

<Card id={experience.id}>
  <div class="grid items-center gap-6 sm:grid-cols-[minmax(0,1fr)_8rem]">
    <div class="min-w-0">
      <p class="text-accent text-sm font-bold tracking-[0.16em] uppercase">
        {experience.organization}
      </p>
      <h2 class="text-ink-muted mt-2 text-2xl font-bold">{experience.role}</h2>

      <time
        datetime={experience.startDate}
        class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
      >
        {formattedStartDate}
      </time>
      <span>-</span>
      <time
        datetime={experience.startDate}
        class="text-accent text-sm font-bold tracking-[0.16em] uppercase"
      >
        {formattedEndDate}
      </time>

      <p class="text-ink/80 mt-4 leading-8 text-pretty">
        {experience.description}
      </p>
    </div>

    <div
      class="bg-canvas-soft mx-auto flex size-28 items-center justify-center rounded-xl p-4 sm:size-32"
    >
      <Image
        src={experience.logo}
        alt={experience.logoAlt}
        width={144}
        class="max-h-full w-full object-contain"
      />
    </div>
  </div>
</Card>
