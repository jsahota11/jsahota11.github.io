---
import Button from "./Button.astro";
import Logo from "./Logo.astro";
---

<div class="sticky top-0 z-20">
    <!-- Navbar background & buttons -->
    <div class="flex justify-end items-center bg-deep h-16 px-6">
        <nav class="flex space-x-4">
            <Button label="About" link="/about" />
            <Button label="Updates" link="/updates" />
            <Button label="Experience" link="/work" />
            <Button label="Projects" link="/projects" />
        </nav>
    </div>

    <!-- Logo outside navbar -->
    <div class="absolute left-3 top-3">
        <Logo size="100" />
    </div>
</div>
